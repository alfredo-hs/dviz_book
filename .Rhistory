bi_theme() +
theme_void()
legend <- bi_legend(pal = "DkBlue",
dim = 3,
xlab = "Debt ",
ylab = "Equity",
size = 10) +
theme(plot.background = element_rect(fill = "aliceblue"))
map <- eurmap_bi %>%
ggplot() +
geom_sf(aes(fill = bi_class),
color = "white", size = 0.1) +
bi_scale_fill(pal = "DkBlue", dim = 3) +
bi_theme() +
theme_void()
legend <- bi_legend(pal = "DkBlue",
dim = 3,
xlab = "Debt ",
ylab = "Equity",
size = 10) +
theme(plot.background = element_rect(fill = "aliceblue"))
finalPlot <- ggdraw() +
draw_plot(map, 0, 0, 1, 1) +
draw_plot(legend,
.15,
.1,
.25, # along x axis
.25)
