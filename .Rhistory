test <- eurdf %>%
filter(nace_r2 == "K",
effect == "SUCC",
sizeclas == "TOTAL",
enterpr == "INN",
unit == "PC"
) %>%
select(
geo,
values,
fin_typ
) %>%
pivot_wider(
names_from = fin_typ,
values_from = values
)
eurmap <- get_eurostat_geospatial(nuts_level = 0, year = 2024)
View(eurmap)
