eurdf_small <- eurdf %>%
filter(nace_r2 == "K",
effect == "SUCC",
sizeclas == "TOTAL",
enterpr == "INN",
unit == "PC"
) %>%
select(
geo,
values,
fin_typ
) %>%
pivot_wider(
names_from = fin_typ,
values_from = values
)
eurmap <- eurmap %>%
left_join(eurdf_small)
eurmap_bi <- bi_class(
eurmap,
x = DEBT,
y = EQUIT,
style = "quantile",
dim = 4   # 3x3 grid = 9 classes
)
View(eurmap_bi)
eurmap %>%
ggplot(aes(fill = bi_class)) +
geom_sf(color = NA, fill = "antiquewhite") +
bi_scale_fill(pal = "DkViolet2", dim = 3, na.value = "antiquewhite")
eurmap_bi %>%
ggplot(aes(fill = bi_class)) +
